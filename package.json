{
  "name": "dev-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=256 vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "node scripts/serve.mjs",
    "serve": "vitepress build docs && node scripts/serve.mjs",
    "new": "node scripts/new.mjs",
    "share:list": "curl -s localhost:7788/dp/__share/api/shares | node -e \"for (const s of JSON.parse(require('fs').readFileSync(0))) console.log(s.path, s.url, s.password)\"",
    "passwd": "node scripts/passwd.mjs",
    "content": "node scripts/content.mjs"
  },
  "devDependencies": {
    "mermaid": "^12.2.0",
    "vitepress": "^1.6.4"
  }
}
